<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/premium_numbers_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#091323">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        <Button
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Back to proxy"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/numbers"
            android:textColor="#EDF6FF"
            android:textSize="23sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <!-- Moved into the list header by the activity so the entire form scrolls. -->
    <LinearLayout
        android:id="@+id/premium_numbers_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Add to your number list"
            android:textColor="#EDF6FF"
            android:textSize="16sp"/>
        <EditText
            android:id="@+id/number_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="124dp"
            android:maxLines="6"
            android:minLines="4"
            android:gravity="top|start"
            android:hint="@string/numbers_hint"
            android:inputType="textMultiLine"
            android:textColor="#EDF6FF"
            android:textColorHint="#8AA2BA"
            android:textSize="15sp"
            android:padding="14dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <Button
                android:id="@+id/add_numbers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_weight="1"
                android:text="@string/add_numbers"/>
            <Button
                android:id="@+id/clear_numbers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/clear_all"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Hold a saved number to delete it"
            android:textSize="14sp"
            android:textColor="#8AA2BA"/>
        <TextView
            android:id="@+id/number_remaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#00DCEB"
            android:textSize="16sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <ListView
        android:id="@+id/number_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#091323"
        android:cacheColorHint="#091323"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"/>
    <LinearLayout
        android:id="@+id/premium_numbers_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
</LinearLayout>
